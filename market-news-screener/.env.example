# Copy to .env and fill in. Nothing here is required to get live data
# flowing - the SEC EDGAR feed needs no key.
#
# FMP's free tier no longer includes any news endpoint (as of their Aug 2025
# API changes) - a paid plan is required. Ask before upgrading.
#
# Finnhub has a genuinely free news tier (60 calls/min, no card needed):
# sign up at https://finnhub.io/register and paste the key below.

FMP_API_KEY=
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=

POLL_INTERVAL_SECONDS=75
CLASSIFY_CONFIDENCE_THRESHOLD=0.6
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD

API_HOST=0.0.0.0
API_PORT=8000

SEC_USER_AGENT=market-news-screener/0.1 (contact: you@example.com)
