# Copy to .env and fill in. Nothing here is required to get live data
# flowing - the SEC EDGAR feed needs no key. FMP requires a free-tier
# signup at https://financialmodelingprep.com/developer/docs (ask before
# upgrading to any paid FMP tier).

FMP_API_KEY=
ANTHROPIC_API_KEY=

POLL_INTERVAL_SECONDS=75
CLASSIFY_CONFIDENCE_THRESHOLD=0.6
WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,AMD

API_HOST=0.0.0.0
API_PORT=8000

SEC_USER_AGENT=market-news-screener/0.1 (contact: you@example.com)
